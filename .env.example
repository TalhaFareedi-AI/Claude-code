# Copy to .env (git ignores it). Never commit a real key.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# cheap = every brain resolves to the cheapest Quick/Smart model (for testing)
BRAIN_POLICY=cheap
# DEV_MODE=1 adds a plan switcher and free test credits. Use it ONLY on your own computer, never on a public server.
DEV_MODE=0

# UNLOCK_ALL=1 gives every visitor the Owner plan: all modes, brains, effort and a huge credit balance.
# Good while you are the only user. Set it to 0 (or remove it) before real users arrive, so plans and limits apply.
UNLOCK_ALL=1

# Admin login (created or reset at every start). Sign in at /admin.html. Remove the password from this file after the first start.
# Or run:  python scripts/create_admin.py you@example.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
# test = a purchase is paid at once (no real money). manual = pending until the admin marks it paid.
PAYMENT_PROVIDER=manual
# Where the SQLite database lives (all chats, users, credits, memory). Back this file up.
# DB_PATH=data/app.db

# ---- Production (public site) ----
# Use UNLOCK_ALL=admin instead of 1, so only YOUR admin login gets every feature. UNLOCK_ALL=1 would give every visitor
# 100,000 free credits on your OpenRouter key. Keep DEV_MODE=0. Set APP_SECRET to a long random text.
# APP_SECRET=
